APP_NAME="RMS Yaskawa"
APP_ENV=local
APP_KEY=base64:K2X9loN++hZbrs2cZumqLQ5ww/ZWtG/+nk+ue3B5PP8=
APP_DEBUG=true
APP_URL=http://localhost:8080
# APP_URL=https:/adm.djncloud.my.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ============================================================
# LOGGING — TETAP
# ============================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# POSTGRESQL 16 — TETAP; sesuaikan dengan ROOT .env / DB aktif
# ============================================================
DB_CONNECTION=pgsql
DB_HOST=postgres_yaskawa
DB_PORT=5432
DB_DATABASE=rms_yaskawa
DB_USERNAME=admin
DB_PASSWORD=123

# ============================================================
# SESSION — TETAP
# ============================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================================================
# BROADCASTING — DIUBAH DARI log MENJADI reverb
# ============================================================
BROADCAST_CONNECTION=reverb

# ============================================================
# RMS LIVE — BARU
# Buka RMS hanya setelah Reverb, npm build, dan Nginx diuji.
# ============================================================
RMS_LIVE_ENABLED=true
RMS_LIVE_STALE_SECONDS=30
RMS_LIVE_RECONCILE_SECONDS=20
RMS_LIVE_FALLBACK_SECONDS=4
RMS_ROBOT_PROBE_ENABLED=true
RMS_ROBOT_PROBE_TIMEOUT_SECONDS=2
RMS_ROBOT_PROBE_UDP_PORTS=10040,10041
RMS_RECOMMENDATION_WRITES_ENABLED=true
RMS_RECOMMENDATION_AUTO_ENABLED=true


# ============================================================
# REVERB — BARU
# App ID dan keys buat unik, lihat merge script.
# Jangan gunakan literal PLACEHOLDER ini di sistem aktif.
# ============================================================
REVERB_APP_ID=rms-yaskawa-local
REVERB_APP_KEY=eaea112a3caf8afbd5541cafc0001fa067bf357c001ef898
REVERB_APP_SECRET=0302572813337173d6150e5f7fb59e4f579cea25d467163d79001d473b07ea04
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=reverb_yaskawa
REVERB_PORT=8080
REVERB_SCHEME=http

# ============================================================
# FILESYSTEM — TETAP
# ============================================================
FILESYSTEM_DISK=local

# ============================================================
# QUEUE — TETAP
# ============================================================
QUEUE_CONNECTION=database

# ============================================================
# CACHE — TETAP
# ============================================================
CACHE_STORE=database

# ============================================================
# MEMCACHED — TETAP
# ============================================================
MEMCACHED_HOST=127.0.0.1

# ============================================================
# REDIS — TETAP (service belum ada)
# ============================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# MAIL — TETAP
# ============================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# AWS STORAGE — TETAP
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================
# VITE — TETAP
# Client WebSocket key diambil dari Laravel Blade, bukan VITE_*.
# ============================================================
VITE_APP_NAME="${APP_NAME}"
